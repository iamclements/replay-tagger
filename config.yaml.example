# ReplayTagger configuration - OPTIONAL
# This file is only needed for game_name_map and notification webhooks.
# All other settings can be configured via environment variables in .env.
# See .env.example for the full list of supported env vars.
#
# If you don't need game_name_map or webhooks, you can skip this file entirely.
# Secrets (PLEX_TOKEN, YouTube credentials) go in .env — not here.

# Directory containing your game clips, organized in sub-folders by game name.
# In Docker this is always /clips (mapped via volume mount in docker-compose.yml).
clips_dir: /clips

# File extensions to process
extensions:
  - .mp4
  - .mkv
  - .mov

# Directory for the SQLite state database and YouTube token cache.
# Keep as "data" (relative) — resolves to /app/data inside the container and
# ./data when running locally. Only change this if you need a custom path.
data_dir: data

# Path to ffmpeg/ffprobe binaries (both included in the Docker image)
ffmpeg_path: ffmpeg
ffprobe_path: ffprobe

# Optional: directory for ffmpeg temp files during tagging.
# Defaults to the same directory as the source clip (enables atomic rename).
# Set this to a non-synced directory (e.g. data/) if Syncthing or another sync
# tool locks temp files that appear in the clips folder, causing EBUSY errors.
# In Docker: set to /app/data. Also settable via FFMPEG_TEMP_DIR env var.
# ffmpeg_temp_dir: data

# Seconds to wait after a file event before processing (lets Syncthing finish writing)
debounce_seconds: 10

# ── Game name overrides (optional) ────────────────────────────────────────────
# Maps clip folder names to the game name written into the genre tag and used
# for Plex collections. Only needed when your capture tool produces folder names
# that differ from how you want the game to appear in Plex.
# NVIDIA Instant Replay uses clean names (e.g. "Apex Legends") so most users
# can omit this section entirely.
#
# game_name_map:
#   "Apex Legends Season 20":  "Apex Legends"
#   "Call of Duty HQ":         "Call of Duty: Warzone"

# ── Plex integration ──────────────────────────────────────────────────────────
plex:
  enabled: true

  # Plex server URL (LAN address is fine — no Plex relay needed)
  url: http://192.168.1.100:32400

  # Token is loaded in priority order:
  #   1. PLEX_TOKEN environment variable
  #   2. data/plex_token file (written automatically by: replaytagger plex-auth)
  # Do not paste the token directly in this file.

  # Name of your game clips library in Plex
  library_name: "Game Clips"

  # Trigger an incremental library scan after tagging
  auto_scan: true

  # Automatically create a smart collection per game via the Plex API
  auto_create_collections: true

  # Set to false if your Plex server uses HTTPS with a self-signed cert (common on LAN)
  # Also set PLEX_VERIFY_SSL=false in your .env
  verify_ssl: true

# ── SteamGridDB collection art (optional) ─────────────────────────────────────
# Set STEAMGRIDDB_API_KEY in .env to automatically fetch portrait artwork from
# SteamGridDB when a new Plex collection is created. The API key is free -
# register at steamgriddb.com and copy it from Profile > Preferences > API.
# This is a secret - keep it in .env, not here.

# ── YouTube archive ───────────────────────────────────────────────────────────
youtube:
  enabled: false

  # Automatically upload new clips when detected in watch mode
  auto_upload: false

  # Default privacy: private | unlisted | public
  # Override per-run with: replaytagger upload --privacy unlisted <file>
  # Or set YOUTUBE_PRIVACY in .env
  privacy: private

  # Days a clip must sit in the folder before auto_upload triggers.
  # Set to 0 (default) to upload immediately. Useful if you trim/rename clips
  # after recording and want to give yourself time before they go to YouTube.
  # Can also be set via YOUTUBE_UPLOAD_AFTER_DAYS in .env
  upload_after_days: 0

  # Download from: Google Cloud Console > APIs & Services > Credentials
  # Place this file in your data directory — locally that is ./data/,
  # in Docker it maps to /app/data/ via the volume mount.
  # Alternatively set YOUTUBE_CLIENT_ID and YOUTUBE_CLIENT_SECRET env vars
  # and skip the file entirely (recommended for Docker/Portainer deployments).
  credentials_file: data/youtube_credentials.json

  # Auto-generated on first run of: replaytagger youtube-auth
  token_file: data/youtube_token.json

  # YouTube category ID for uploaded clips. 20 = Gaming (default).
  # Full list: https://developers.google.com/youtube/v3/docs/videoCategories/list
  # Can also be set via YOUTUBE_CATEGORY_ID in .env
  # category_id: "20"

  # Additional tags applied to every uploaded clip alongside the game name.
  # Can also be set via YOUTUBE_TAGS in .env (comma-separated)
  # tags: [gaming, clips]

# ── Notifications ─────────────────────────────────────────────────────────────
# Supported types:  discord | ntfy | generic
# Supported events: scan_complete | error | clip_tagged | clip_uploaded
#
# scan_complete and error are recommended defaults - clip_tagged and
# clip_uploaded fire per file and can be noisy on large backlogs.
#
# notifications:
#   webhooks:
#     - url: https://discord.com/api/webhooks/SERVER_ID/TOKEN
#       type: discord
#       events: [scan_complete, error]
#
#     - url: https://ntfy.sh/your-topic
#       type: ntfy
#       events: [scan_complete, error]
#
#     - url: https://example.com/webhook
#       type: generic
#       events: [scan_complete, error]

# ── Logging ───────────────────────────────────────────────────────────────────
logging:
  level: INFO          # DEBUG | INFO | WARNING | ERROR
  format: json         # json (production) | text (human-readable dev output)
