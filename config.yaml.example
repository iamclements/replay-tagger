# ReplayTagger configuration
# Copy this file to config.yaml and adjust to your setup.
# Secrets (PLEX_TOKEN, YouTube credentials) go in .env — not here.

# Directory containing your game clips, organized in sub-folders by game name.
# In Docker this is always /clips (mapped via volume mount in docker-compose.yml).
clips_dir: /clips

# File extensions to process
extensions:
  - .mp4
  - .mkv
  - .mov

# Directory for the SQLite state database and YouTube token cache.
# Relative paths resolve from the working directory — in Docker (WORKDIR /app)
# this becomes /app/data, which matches the volume mount in docker-compose.yml.
data_dir: data

# Path to ffmpeg/ffprobe binaries (both included in the Docker image)
ffmpeg_path: ffmpeg
ffprobe_path: ffprobe

# Seconds to wait after a file event before processing (lets Syncthing finish writing)
debounce_seconds: 10

# ── Plex integration ──────────────────────────────────────────────────────────
plex:
  enabled: true

  # Plex server URL (LAN address is fine — no Plex relay needed)
  url: http://192.168.1.100:32400

  # Token is loaded in priority order:
  #   1. PLEX_TOKEN environment variable
  #   2. data/plex_token file (written automatically by: replaytagger plex-auth)
  # Do not paste the token directly in this file.

  # Name of your game clips library in Plex
  library_name: "Game Clips"

  # Trigger an incremental library scan after tagging
  auto_scan: true

  # Automatically create a smart collection per game via the Plex API
  auto_create_collections: true

  # Set to false if your Plex server uses HTTPS with a self-signed cert (common on LAN)
  # Also set PLEX_VERIFY_SSL=false in your .env
  verify_ssl: true

# ── YouTube archive ───────────────────────────────────────────────────────────
youtube:
  enabled: false

  # Automatically upload new clips when detected in watch mode
  auto_upload: false

  # Default privacy: private | unlisted | public
  # Override per-run with: replaytagger upload --privacy unlisted <file>
  # Or set YOUTUBE_PRIVACY in .env
  privacy: private

  # Days a clip must sit in the folder before auto_upload triggers.
  # Set to 0 (default) to upload immediately. Useful if you trim/rename clips
  # after recording and want to give yourself time before they go to YouTube.
  # Can also be set via YOUTUBE_UPLOAD_AFTER_DAYS in .env
  upload_after_days: 0

  # Download from: Google Cloud Console > APIs & Services > Credentials
  # Place this file in your data directory — locally that is ./data/,
  # in Docker it maps to /app/data/ via the volume mount.
  # Alternatively set YOUTUBE_CLIENT_ID and YOUTUBE_CLIENT_SECRET env vars
  # and skip the file entirely (recommended for Docker/Portainer deployments).
  credentials_file: data/youtube_credentials.json

  # Auto-generated on first run of: replaytagger youtube-auth
  token_file: data/youtube_token.json

# ── Logging ───────────────────────────────────────────────────────────────────
logging:
  level: INFO          # DEBUG | INFO | WARNING | ERROR
  format: json         # json (production) | text (human-readable dev output)
