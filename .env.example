# Copy this file to .env and fill in your values.
# .env is listed in .gitignore; NEVER commit secrets.

# ── User / group identity ──────────────────────────────────────────────────────
# Set to the UID/GID that owns your clips folder on the host so the container
# can read and write files without permission errors.
# Run `id` on your server to find your UID and GID.
PUID=1000
PGID=1000

# ── Clips directory ────────────────────────────────────────────────────────────
# Absolute path to your game clips folder (used by docker-compose)
CLIPS_DIR=/path/to/your/game/clips

# ── Plex ──────────────────────────────────────────────────────────────────────
# Get your token from Plex Web: browse to any item → (...) → Get Info → View XML
# Copy X-Plex-Token from the URL bar. Tokens don't expire.
PLEX_TOKEN=your_plex_token_here
PLEX_URL=http://192.168.1.100:32400

# Enable Plex integration (required if not using config.yaml)
PLEX_ENABLED=true

# Name of your game clips library in Plex (must match exactly, case-sensitive)
PLEX_LIBRARY_NAME=Gaming Clips

# Uncomment if your Plex server uses HTTPS with a self-signed cert (common on LAN)
# PLEX_VERIFY_SSL=false

# Uncomment to disable automatic Plex scan or collection creation
# PLEX_AUTO_SCAN=true
# PLEX_AUTO_COLLECTIONS=true

# ── YouTube ───────────────────────────────────────────────────────────────────
# Uncomment to enable YouTube uploads without editing config.yaml
# YOUTUBE_ENABLED=true

# Automatically upload new clips as they arrive in watch mode
# YOUTUBE_AUTO_UPLOAD=true

# OAuth client credentials from Google Cloud Console (TV and Limited Input Devices type).
# Use these instead of mounting a credentials JSON file (recommended for Docker deployments).
# YOUTUBE_CLIENT_ID=your_client_id_here
# YOUTUBE_CLIENT_SECRET=your_client_secret_here

# Override the privacy setting from config.yaml (private | unlisted | public)
YOUTUBE_PRIVACY=private

# Uncomment to delay auto-uploads until clips have been in the folder for N days
# (gives time to trim and rename before they appear on YouTube)
# YOUTUBE_UPLOAD_AFTER_DAYS=3

# ── Watcher ───────────────────────────────────────────────────────────────────
# Seconds to wait after a file event before processing (lets Syncthing finish writing)
# DEBOUNCE_SECONDS=10

# Optional: directory for ffmpeg temp files. Set to /app/data to keep temp files
# out of the synced clips folder (prevents EBUSY errors when using Syncthing).
# FFMPEG_TEMP_DIR=/app/data

# ── Logging ───────────────────────────────────────────────────────────────────
# Use "text" for human-readable output, "json" for structured production logs
LOG_LEVEL=INFO
LOG_FORMAT=json
